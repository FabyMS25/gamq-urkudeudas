{
  "info": {
    "name": "Urku Deudas 25 - Internal App Requests",
    "description": "Importable Postman collection for requests used internally by the Yii frontend/backend app. Protected POST routes need a valid app session and _csrf token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login page / CSRF source",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": {
              "raw": "{{baseUrl}}?r=site/login",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "site/login" } ]
            }
          },
          "response": []
        },
        {
          "name": "POST login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "text/html,application/json,*/*" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_csrf", "value": "{{csrfToken}}", "type": "text" },
                { "key": "LoginForm[username]", "value": "{{appUsername}}", "type": "text" },
                { "key": "LoginForm[password]", "value": "{{appPassword}}", "type": "text" },
                { "key": "LoginForm[rememberMe]", "value": "0", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}?r=site/login",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "site/login" } ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Common internal pages",
      "item": [
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": {
              "raw": "{{baseUrl}}?r=site/index",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "site/index" } ]
            }
          },
          "response": []
        },
        {
          "name": "Pagos index",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": {
              "raw": "{{baseUrl}}?r=pagos/index",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "pagos/index" } ]
            }
          },
          "response": []
        },
        {
          "name": "Pagos eventuales index",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": {
              "raw": "{{baseUrl}}?r=pagos-eventuales/index",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "pagos-eventuales/index" } ]
            }
          },
          "response": []
        },
        {
          "name": "Contribuyentes index",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": {
              "raw": "{{baseUrl}}?r=contribuyentes/index",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "contribuyentes/index" } ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/index.php" },
    { "key": "csrfToken", "value": "" },
    { "key": "appUsername", "value": "" },
    { "key": "appPassword", "value": "" }
  ]
}
