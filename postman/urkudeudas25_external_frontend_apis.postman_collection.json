{
  "info": {
    "name": "Urku Deudas 25 - External Frontend APIs",
    "description": "Importable Postman collection for external frontend endpoints. RUAT requests were reviewed against ApiRuatController.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Api RUAT",
      "item": [
        {
          "name": "Login RUAT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is not a server error', function () { pm.expect(pm.response.code).to.be.below(500); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.environment.set('ruatToken', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ruatUsername}}\",\n  \"password\": \"{{ruatPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}?r=api-ruat/login",
              "host": [ "{{baseUrl}}" ],
              "query": [ { "key": "r", "value": "api-ruat/login" } ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar contribuyente",
