              "raw": "{\n  \"codigoAlcaldia\": \"{{codigoAlcaldia}}\",\n  \"contribuyente\": {\n    \"contri_ci\": \"{{numeroDocumento}}\",\n    \"contri_tipo_documento_ruat\": \"CI\",\n    \"ext_id\": \"{{extId}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
