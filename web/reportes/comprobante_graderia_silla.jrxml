	<queryString>
		<![CDATA[SELECT CAST(pago_id AS TEXT) codigo,
          grad_id, usua_id, contri_id, tip_arm_id,
          lpad(pago_nro_liquidacion,8,'0') AS pago_nro_liquidacion,
          pago_nro_comprobante,
          pago_longitud_modificada, pago_descuento_porcentaje,
          pago_descuento_monto, pago_importe_patente,
          pago_aseo, pago_reposicion,
          pago_importe_total,
          pago_id_user_preliquidacion,
          pago_preliquidacion,
          pago_fecha_hora_preliquidacion,
          pago_fecha_hora_cobro,
          pago_con_exencion,
          contri_nombres, contri_paterno, contri_materno, contri_ci, contri_nit,
          liquidador, grad_codigo, grad_direccion, grad_longitud, grad_acera,
          grad_tipo_armado, grad_tipo_sitio, grad_vendido, grad_reservado,
          grad_estado,
          tip_arm_descricpion, tip_arm_patente, tip_arm_tasa_aseo,
          tip_arm_unidad_medida,  zona_nombre, zona_color, zona_descripcion
          FROM view_graderias_sillas
          WHERE pago_id = $P{id_pago}]]>
	</queryString>
