<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_descargo_sentajes" language="groovy" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a5f224c-62d6-4b08-9fea-ee5f013fa76d">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="logo_path" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT RE.concepto,SUM(RE.total_importe) AS importe_total
        FROM
        (UNION ALL
		SELECT INITCAP(CA.categ_codigo) AS concepto,SUM(PE.eventual_importe_total) AS total_importe
		FROM pagos_eventuales PE
		INNER JOIN actividades_economicas AE ON AE.activi_id = PE.activi_id
		INNER JOIN categorias CA ON CA.categ_id = AE.categ_id
		WHERE sitios_id IS NULL AND eventual_nro_comprobante IS NOT NULL
		GROUP BY CA.categ_codigo) AS RE
		GROUP BY RE.concepto
        ORDER BY importe_total ASC]]>
	</queryString>
	<field name="concepto" class="java.lang.String"/>
	<field name="importe_total" class="java.math.BigDecimal"/>
	<variable name="TOTAL_RESUMEN" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{importe_total}]]></variableExpression>
	</variable>
