<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="comprobante_infraccion" pageWidth="612" pageHeight="792" columnWidth="552" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" uuid="fe922b6a-3d2c-46e3-8d26-414109229e28">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<parameter name="id_pago" class="java.lang.Integer"/>
	<parameter name="monto_literal" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
            pi.infraccion_id,
            lpad(pi.infraccion_id::text, 8, '0') AS nro_liquidacion,
            pi.codigo_usuario,
            pi.codigo_contribuyente,
            pi.numero_documento,
            pi.tipo_documento,
            pi.expedido,
            pi.tipo_infraccion,
            COALESCE(pi.descripcion_infraccion, '') AS descripcion_infraccion,
            COALESCE(pi.lugar_infraccion, '') AS lugar_infraccion,
            pi.fecha_infraccion,
            pi.gestion,
            pi.codigo_clasificador,
            pi.monto,
            COALESCE(pi.observacion, '') AS observacion,
            pi.numero_tasa,
            pi.infraccion_pagado,
            CASE WHEN pi.infraccion_pagado = 1 THEN 'PAGADO' ELSE 'PENDIENTE DE PAGO' END AS estado_pago,
            pi.fecha_pago,
            pi.created_at,
            pi.updated_at,
            trim(COALESCE(c.contri_nombres, '') || ' ' || COALESCE(c.contri_paterno, '') || ' ' || COALESCE(c.contri_materno, '')) AS contribuyente,
            c.contri_ci,
            c.contri_direccion,
            c.contri_telefono::text AS contri_telefono,
            c.contri_nit::text AS contri_nit,
            c.contri_codigo_ruat,
            trim(COALESCE(u.usua_nombres, '') || ' ' || COALESCE(u.usua_apellidos, '')) AS usuario
        FROM pagos_infracciones pi
        LEFT JOIN contribuyentes c ON c.contri_id = pi.contri_id
        LEFT JOIN usuario u ON u.usua_id = pi.usua_id
        WHERE pi.infraccion_id = $P{id_pago}]]>
	</queryString>
