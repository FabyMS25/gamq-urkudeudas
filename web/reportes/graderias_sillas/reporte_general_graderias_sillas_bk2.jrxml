	<queryString>
		<![CDATA[SELECT
    -- pago_id, tip_arm_id,
        COALESCE(pago_nro_comprobante, 0) nro_comprobante,
        --pago_nro_comprobante,
	--pago_nro_liquidacion,
       pago_longitud_modificada,
       pago_importe_patente,
       pago_aseo,
       pago_reposicion,
       pago_importe_total,
       pago_anulado,
       pago_anulado_detalle,
       pago_anulado_fecha_hora,
       --pago_id_user_preliquidacion, pago_preliquidacion, pago_fecha_hora_preliquidacion, liquidador,
       --COALESCE(CAST(pago_fecha_hora_cobro AS VARCHAR), '') fecha_hora_cobro,
       COALESCE(TO_CHAR(pago_fecha_hora_cobro, 'DD/MM/YYYY'), '') fecha_hora_cobro,
       --pago_fecha_hora_cobro,
       pago_cobrado,
       pago_con_exencion,
       pago_estado,
       ext_id, sindi_id,
       contri_nombres, contri_paterno, contri_materno, contri_ci, contri_nit,
       grad_codigo, grad_direccion,
       grad_longitud, grad_acera,
       grad_tipo_armado, grad_tipo_sitio,
       tip_arm_descricpion, tip_arm_patente, tip_arm_tasa_aseo, tip_arm_unidad_medida,
       gest_id,
       zona_nombre, zona_color, zona_descripcion,
				(usuario.usua_nombres|| ' '||usuario.usua_apellidos) AS cajero
       FROM view_graderias_sillas
       INNER JOIN  usuario ON usuario.usua_id = view_graderias_sillas.usua_id
       WHERE  pago_estado = 1 AND (pago_anulado = 0  OR pago_anulado = 1)
       --AND (pago_fecha_hora_cobro BETWEEN '2022/08/05 00:00' AND '2022/08/09 23:59')
       ORDER BY zona_nombre, pago_nro_comprobante::INT ASC]]>
	</queryString>
