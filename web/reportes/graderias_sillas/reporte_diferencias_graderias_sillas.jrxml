	<queryString language="SQL">
		<![CDATA[SELECT pago_nro_comprobante,
            contribuyente,
            grad_codigo,
            zona_nombre,
            pago_longitud_modificada,
            pago_cobrado,
            pago_importe_total,
            calculo_real,
            diferencia,
            pago_fecha_hora_cobro,
            cobrador
FROM view_diferencias_cobros_graderias
WHERE pago_cobrado = 1
ORDER BY zona_nombre::TEXT ASC]]>
	</queryString>
