<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_graderias_vendidas_disponibles" language="groovy" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2a3de7cb-c6e3-407e-ba74-965027487af9">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="191"/>
	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT GS.grad_id, GS.grad_codigo, GS.grad_direccion, GS.grad_acera, GS.grad_tipo_armado, GS.grad_longitud,
COALESCE(PG.longitud_vendida,0) AS longitud_venta,
(GS.grad_longitud - COALESCE(PG.longitud_vendida,0)) AS disponibles,
COALESCE(PG.pago_nro_liquidacion, '') AS nro_liquidacion,
COALESCE(PG.pago_importe_total,0) AS importe_total,
COALESCE(CAST(PG.pago_fecha_hora_preliquidacion AS TEXT),'') AS fecha_hora_preliquidacion,
COALESCE(PG.pago_id_user_preliquidacion, 0) AS id_user_preliquidacion, ZN.zona_nombre,
(us.usua_nombres::text || ' '::text) || us.usua_apellidos::text AS liquidador
FROM graderias_sillas GS
LEFT JOIN (
SELECT grad_id, pago_nro_liquidacion, pago_importe_total, pago_fecha_hora_preliquidacion,
	pago_id_user_preliquidacion, SUM(pago_longitud_modificada) AS longitud_vendida
	FROM pagos
	WHERE pago_cobrado = 1 AND pago_anulado = 0
	GROUP BY grad_id, pago_nro_liquidacion, pago_importe_total,
	pago_fecha_hora_preliquidacion,
	pago_id_user_preliquidacion) PG ON PG.grad_id = GS.grad_id
INNER JOIN zonas ZN ON ZN.zona_id = GS.zona_id
INNER JOIN gestiones GE ON GE.gest_id = ZN.gest_id AND GE.gest_id = GS.gest_id
LEFT JOIN usuario US ON US.usua_id = PG.pago_id_user_preliquidacion
WHERE GS.grad_estado = 1 AND (grad_reservado = 0 OR grad_reservado ISNULL)
ORDER BY GS.grad_codigo]]>
	</queryString>
	<field name="grad_id" class="java.lang.Integer"/>
	<field name="grad_codigo" class="java.lang.String"/>
	<field name="grad_direccion" class="java.lang.String"/>
	<field name="grad_acera" class="java.lang.String"/>
	<field name="grad_tipo_armado" class="java.lang.String"/>
	<field name="grad_longitud" class="java.math.BigDecimal"/>
	<field name="longitud_venta" class="java.math.BigDecimal"/>
	<field name="disponibles" class="java.math.BigDecimal"/>
	<field name="nro_liquidacion" class="java.lang.String"/>
	<field name="importe_total" class="java.math.BigDecimal"/>
	<field name="fecha_hora_preliquidacion" class="java.lang.String"/>
	<field name="id_user_preliquidacion" class="java.lang.Integer"/>
	<field name="zona_nombre" class="java.lang.String"/>
	<field name="liquidador" class="java.lang.String"/>
	<variable name="sum_total_importe" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{importe_total}]]></variableExpression>
	</variable>
	<group name="zona_nombre">
