	<parameter name="monto_literal" class="java.lang.String"/>
	<parameter name="id_detalle" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
        DD.detalle_id,
        DE.desc_nro_comprobante,
        RS.razon_nombre,
        DE.desc_responsable,
        DE.desc_impreso,
        DD.detalle_nro_inicio,
        DD.detalle_nro_limite,
        DD.detalle_precio,
        DD.detalle_cantidad,
        DD.detalle_importe_bs,
		(DE.desc_impreso - DD.detalle_cantidad) AS cantidad_saldo,
		((DE.desc_impreso - DD.detalle_cantidad) * DD.detalle_precio) AS total_importe_saldo,
        (DE.desc_impreso * DD.detalle_precio) AS total_importe_esperado,
        DE.desc_fecha_hora,
        DD.detalle_fecha_entrega,
        (US.usua_nombres||' '||US.usua_apellidos) AS preliquidador
        FROM descargos DE
        INNER JOIN detalle_descargos DD ON DD.desc_id = DE.desc_id
        INNER JOIN razon_sociales RS ON RS.razon_id = DE.razon_id
        LEFT JOIN usuario US ON US.usua_id = DE.usua_id
        WHERE DD.detalle_id = $P{id_detalle} AND DE.desc_estado = 1
        AND (desc_anulado IS NULL OR desc_anulado = 0)]]>
	</queryString>
