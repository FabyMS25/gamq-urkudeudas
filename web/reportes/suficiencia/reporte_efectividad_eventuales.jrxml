	<parameter name="logo_path" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[SELECT 'Sitios eventuales, Espectáculos y Publicidad' AS descripcion,
        TS.codigo, TS.total_sitios, SV.sitios_vendidos,
        (TS.total_sitios - SV.sitios_vendidos) AS sitios_sobrantes,
        SV.total_importe
        FROM (SELECT sitios_codigo AS codigo, COUNT(sitios_codigo) total_sitios
        FROM sitios_eventuales
        WHERE sitios_es_alasita = false
        GROUP BY sitios_codigo
        ORDER BY sitios_codigo ASC) TS
        INNER JOIN
        (SELECT RE.sitios_codigo as codigo,
        COUNT(sitios_codigo) AS sitios_vendidos, SUM(eventual_importe_total) AS total_importe
        FROM (SELECT SE.sitios_codigo, PE.eventual_importe_total
        FROM pagos_eventuales PE
        INNER JOIN sitios_eventuales SE ON SE.sitios_id = PE.sitios_id
        WHERE PE.eventual_nro_comprobante IS NOT NULL
        AND PE.eventual_estado = 1 AND SE.sitios_es_alasita = false) RE
        GROUP BY RE.sitios_codigo) SV ON SV.codigo = TS.codigo]]>
	</queryString>
	<field name="codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="total_sitios" class="java.lang.Integer"/>
	<field name="sitios_vendidos" class="java.lang.Integer"/>
	<field name="sitios_sobrantes" class="java.lang.Integer"/>
	<field name="total_importe" class="java.math.BigDecimal"/>
	<variable name="tot_sitios_disponibles" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_sitios}]]></variableExpression>
	</variable>
	<variable name="tot_sitios_vendidos" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sitios_vendidos}]]></variableExpression>
	</variable>
	<variable name="tot_sitios_sobrantes" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sitios_sobrantes}]]></variableExpression>
	</variable>
	<variable name="total_importe_recaudado" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_importe}]]></variableExpression>
	</variable>
