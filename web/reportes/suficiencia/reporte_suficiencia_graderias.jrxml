	<property name="ireport.y" value="0"/>
	<parameter name="logo_path" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT VG.tip_arm_id,VG.zona_nombre,VG.grad_tipo_armado, VG.grad_codigo,
            VG.grad_resto, SUM(pago_longitud_modificada) AS metros_vendidos,
            VG.grad_longitud, VG.tip_arm_patente, VG.tip_arm_tasa_aseo,VG.pago_reposicion,
            ((SUM(pago_longitud_modificada)*VG.tip_arm_patente) + (SUM(pago_longitud_modificada)*VG.tip_arm_tasa_aseo) + SUM(pago_reposicion)) AS calculo_importe
            --SUM(pago_importe_total) AS importe_total
            FROM view_graderias_sillas VG
            WHERE  pago_estado = 1 AND (pago_anulado = 0  OR pago_anulado = 1)
            AND pago_nro_comprobante IS NOT NULL
            --AND (pago_fecha_hora_cobro BETWEEN '2022/08/05 00:00' AND '2022/09/30 23:59')
            GROUP BY VG.tip_arm_id, VG.zona_nombre,VG.grad_tipo_armado, VG.grad_codigo,
            VG.grad_resto,VG.grad_longitud, VG.tip_arm_patente, VG.tip_arm_tasa_aseo, VG.pago_reposicion
            ORDER BY VG.zona_nombre, VG.grad_tipo_armado, VG.grad_codigo ASC]]>
	</queryString>
	<field name="tip_arm_id" class="java.lang.Integer"/>
	<field name="zona_nombre" class="java.lang.String"/>
	<field name="grad_tipo_armado" class="java.lang.String"/>
	<field name="grad_codigo" class="java.lang.String"/>
	<field name="grad_resto" class="java.math.BigDecimal"/>
	<field name="metros_vendidos" class="java.math.BigDecimal"/>
	<field name="grad_longitud" class="java.math.BigDecimal"/>
	<field name="tip_arm_patente" class="java.math.BigDecimal"/>
	<field name="tip_arm_tasa_aseo" class="java.math.BigDecimal"/>
	<field name="calculo_importe" class="java.math.BigDecimal"/>
	<field name="pago_reposicion" class="java.math.BigDecimal"/>
	<variable name="total_importe_calculado" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{calculo_importe}]]></variableExpression>
	</variable>
