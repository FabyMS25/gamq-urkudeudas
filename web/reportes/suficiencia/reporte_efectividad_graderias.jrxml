	<parameter name="logo_path" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CO.zona_nombre, CO.grad_tipo_armado, CO.grad_codigo,
CO.mts_disponibles, CO.mts_vendidos, CO.mts_sobrantes,
CO.importe_total, CO.estado
FROM
(SELECT ZN.zona_nombre, GS.grad_tipo_armado, GS.grad_codigo,
GS.grad_resto AS mts_disponibles,
COALESCE(PG.pago_longitud_modificada,0) AS mts_vendidos,
(GS.grad_resto - COALESCE(PG.pago_longitud_modificada,0)) AS mts_sobrantes,
COALESCE(PG.pago_importe_total,0) AS importe_total, 'Sin movimiento' AS estado
FROM graderias_sillas GS
LEFT JOIN pagos PG ON PG.grad_id = GS.grad_id
LEFT JOIN zonas ZN ON ZN.zona_id = GS.zona_id
WHERE GS.grad_codigo NOT IN (SELECT VI.grad_codigo
FROM view_graderias_sillas VI
WHERE VI.pago_estado = 1 AND (VI.pago_anulado = 0 OR VI.pago_anulado = 1)
AND VI.pago_nro_comprobante IS NOT NULL
GROUP BY VI.zona_nombre, VI.grad_tipo_armado, VI.grad_codigo, VI.grad_resto
ORDER BY VI.zona_nombre, VI.grad_tipo_armado, VI.grad_codigo ASC)
AND PG.pago_longitud_modificada IS NULL
UNION ALL
SELECT VG.zona_nombre, VG.grad_tipo_armado, VG.grad_codigo,
VG.grad_resto AS mts_disponibles, SUM(VG.pago_longitud_modificada) AS mts_vendidos,
(VG.grad_resto - SUM(VG.pago_longitud_modificada)) AS mts_sobrantes,
SUM(VG.pago_importe_total) AS importe_total, 'Cobrados' AS estado
FROM view_graderias_sillas VG
WHERE VG.pago_estado = 1 AND (VG.pago_anulado = 0 OR VG.pago_anulado = 1)
AND VG.pago_nro_comprobante IS NOT NULL
GROUP BY VG.zona_nombre,VG.grad_tipo_armado, VG.grad_codigo, VG.grad_resto
UNION ALL
SELECT VG.zona_nombre, VG.grad_tipo_armado, VG.grad_codigo,
VG.grad_resto AS mts_disponibles,
SUM(VG.pago_longitud_modificada) AS mts_vendidos,
(VG.grad_resto - SUM(VG.pago_longitud_modificada)) AS mts_sobrantes,
SUM(VG.pago_importe_total) AS importe_total, 'Pendientes' AS estado
FROM view_graderias_sillas VG
WHERE VG.pago_estado = 1 AND (VG.pago_anulado = 0 OR VG.pago_anulado = 1)
AND VG.pago_cobrado = 0 AND VG.pago_nro_comprobante IS NULL
GROUP BY VG.grad_codigo, VG.zona_nombre, VG.grad_tipo_armado, VG.grad_resto) AS CO
GROUP BY CO.estado,CO.zona_nombre, CO.grad_tipo_armado, CO.grad_codigo,
CO.mts_disponibles, CO.mts_vendidos, CO.mts_sobrantes, CO.importe_total
ORDER BY CO.estado, CO.zona_nombre, CO.grad_tipo_armado, CO.grad_codigo ASC]]>
	</queryString>
	<field name="zona_nombre" class="java.lang.String"/>
	<field name="grad_tipo_armado" class="java.lang.String"/>
	<field name="grad_codigo" class="java.lang.String"/>
