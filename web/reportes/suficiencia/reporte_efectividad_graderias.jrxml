<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_descargo_sentajes" language="groovy" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a5f224c-62d6-4b08-9fea-ee5f013fa76d">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="logo_path" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT DE.desc_nro_comprobante,
        DD.nro_comprobante,
        RS.razon_nombre,
        DE.desc_responsable,
        DE.desc_impreso,
        DD.detalle_nro_inicio,
        DD.detalle_nro_limite,
        DD.detalle_precio,
        DD.detalle_cantidad,
        DD.detalle_importe_bs,
        (DD.detalle_importe_bs - (COALESCE(DD.detalle_cantidad_anulado, 0) * DD.detalle_precio)) AS total_importe_bs,
		(DE.desc_impreso - DD.detalle_cantidad) AS cantidad_saldo,
		((DE.desc_impreso - DD.detalle_cantidad) * DD.detalle_precio) AS total_importe_saldo,
        DE.desc_fecha_hora,
        DD.detalle_fecha_entrega,
        DD.detalle_feria
        FROM descargos DE
        JOIN detalle_descargos DD ON DD.desc_id = DE.desc_id
        JOIN razon_sociales RS ON RS.razon_id = DE.razon_id
        WHERE detalle_estado = 1
		AND detalle_estado_pago= 1
        ORDER BY DD.detalle_id, DD.nro_comprobante, RS.razon_nombre ASC]]>
	</queryString>
	<field name="desc_nro_comprobante" class="java.lang.Integer"/>
	<field name="razon_nombre" class="java.lang.String"/>
	<field name="desc_responsable" class="java.lang.String"/>
	<field name="desc_impreso" class="java.lang.Integer"/>
	<field name="detalle_nro_inicio" class="java.lang.Integer"/>
	<field name="detalle_nro_limite" class="java.lang.Integer"/>
	<field name="detalle_precio" class="java.math.BigDecimal"/>
	<field name="detalle_cantidad" class="java.lang.Integer"/>
	<field name="detalle_importe_bs" class="java.math.BigDecimal"/>
	<field name="detalle_fecha_entrega" class="java.sql.Date"/>
	<field name="cantidad_saldo" class="java.lang.String"/>
	<field name="total_importe_saldo" class="java.lang.String"/>
	<field name="nro_comprobante" class="java.lang.String"/>
	<field name="total_importe_bs" class="java.math.BigDecimal"/>
	<field name="detalle_feria" class="java.lang.String"/>
	<variable name="importe_total_sentaje" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{detalle_importe_bs}]]></variableExpression>
	</variable>
	<variable name="actividad_importe_total_sentaje" class="java.math.BigDecimal" resetType="Group" resetGroup="Actividad" calculation="Sum">
		<variableExpression><![CDATA[$F{detalle_importe_bs}]]></variableExpression>
	</variable>
