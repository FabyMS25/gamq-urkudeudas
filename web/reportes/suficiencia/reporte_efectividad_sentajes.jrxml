<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_descargo_sentajes" language="groovy" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a5f224c-62d6-4b08-9fea-ee5f013fa76d">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="logo_path" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT RS.razon_nombre,
        SUM(DE.desc_impreso) AS sentaje_existente,
        DD.detalle_precio,
        SUM(DD.detalle_cantidad) AS sentaje_cobrado,
        SUM(detalle_importe_bs) AS total_importe,
        (SUM(DE.desc_impreso) - SUM(DD.detalle_cantidad)) AS cantidad_saldo
        FROM descargos DE
        INNER JOIN detalle_descargos DD ON DD.desc_id = DE.desc_id
        INNER JOIN razon_sociales RS ON RS.razon_id = DE.razon_id
        WHERE DE.desc_estado = 1
        AND detalle_estado = 1
        AND nro_comprobante IS NOT NULL
        AND (desc_anulado IS NULL OR desc_anulado = 0)
        GROUP BY RS.razon_nombre, DD.detalle_precio
        ORDER BY RS.razon_nombre, DD.detalle_precio ASC]]>
	</queryString>
	<field name="razon_nombre" class="java.lang.String"/>
	<field name="sentaje_existente" class="java.math.BigDecimal"/>
	<field name="detalle_precio" class="java.math.BigDecimal"/>
	<field name="sentaje_cobrado" class="java.math.BigDecimal"/>
	<field name="total_importe" class="java.math.BigDecimal"/>
	<field name="cantidad_saldo" class="java.math.BigDecimal"/>
	<variable name="importe_total_sentaje" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_importe}]]></variableExpression>
	</variable>
	<variable name="SUBTOTAL_GROUP" class="java.math.BigDecimal" resetType="Group" resetGroup="razon_nombre" calculation="Sum">
		<variableExpression><![CDATA[$F{total_importe}]]></variableExpression>
	</variable>
	<variable name="cantidad_sentaje_disponible" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sentaje_existente}]]></variableExpression>
	</variable>
	<variable name="cantidad_sentaje_cobrado" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sentaje_cobrado}]]></variableExpression>
	</variable>
	<variable name="cantidad_sentaje_sobrante" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cantidad_saldo}]]></variableExpression>
	</variable>
	<group name="razon_nombre">
		<groupExpression><![CDATA[$F{razon_nombre}]]></groupExpression>
	</group>
