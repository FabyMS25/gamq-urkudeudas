	<queryString>
		<![CDATA[SELECT nro_comprobante, contribuyente, sitios_codigo,
            sitios_descripcion, activi_descripcion, sitios_numero_sitio,
            eventual_fecha_inicio, eventual_fecha_limite, importe_total,
            calculo_real, diferencia, eventual_fecha_hora_pago, cobrador
            FROM view_diferencias_cobros_eventuales
            ORDER BY nro_comprobante::INT ASC]]>
	</queryString>
