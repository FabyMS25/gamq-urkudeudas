	<parameter name="logo_path" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[-- solo pagados, sin anulados
SELECT
  pe.eventual_fecha_hora_pago,
  pe.eventual_nro_comprobante,
  pe.eventual_nro_liquidacion,
  con.contri_nombres|| ' ' || con.contri_paterno || ' ' || con.contri_materno AS contribuyente,
  con.contri_ci,
  ae.activi_descripcion,
  se.sitios_codigo,
  se.sitios_descripcion,
  se.sitios_numero_sitio,
  liq.usua_ci AS ci_liquidador,
  liq.usua_nombres || ' ' || liq.usua_apellidos AS liquidador,
  caj.usua_ci AS ci_cajero,
  caj.usua_nombres || ' ' || caj.usua_apellidos AS cajero,
  pe.eventual_cantidad_dia,
  pe.eventual_importe_patente,
  pe.eventual_costo_comprobante,
  pe.eventual_costo_sentaje,
  pe.eventual_costo_aseo,
  pe.eventual_importe_total
FROM
  public.pagos_eventuales pe
  INNER JOIN public.usuario caj ON caj.usua_id = pe.usua_id
  INNER JOIN public.contribuyentes con ON pe.contri_id = con.contri_id
  LEFT JOIN public.sitios_eventuales se ON se.sitios_id = pe.sitios_id
  INNER JOIN public.actividades_economicas ae ON pe.activi_id = ae.activi_id
  INNER JOIN public.usuario liq ON liq.usua_id = pe.eventual_user_id_preliquidacion
WHERE pe.eventual_nro_comprobante IS NOT NULL
    AND se.sitios_es_alasita = true
    AND pe.eventual_estado = 1
   --AND pe.eventual_fecha_hora_pago::DATE BETWEEN '2022/08/01 00:00' AND '2022/09/19 23:59'

  -- AND caj.usua_id = 29
  --AND se.sitios_codigo LIKE 'PUENTE-%'
  --AND pe.eventual_nro_comprobante = 24755
ORDER BY caj.usua_ci, pe.eventual_nro_comprobante, pe.eventual_nro_liquidacion]]>
	</queryString>
